{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sTool PDF",
  "version": "0.1.0",
  "identifier": "vn.solyan.pdf",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "sTool PDF",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' blob: http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "resources/core/": "core/",
      "resources/office/": "office/",
      "resources/ocr/": "ocr/",
      "resources/sign/": "sign/",
      "resources/archive/": "archive/"
    },
    "category": "Productivity",
    "shortDescription": "Bộ công cụ PDF dễ dùng cho Windows",
    "longDescription": "SolYan PDF cho Windows cung cấp các công cụ sắp xếp, chỉnh sửa, chuyển đổi, OCR, bảo mật và xử lý PDF theo hướng local-first.",
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "description": "PDF document"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Vietnamese",
          "English"
        ]
      }
    },
    "icon": [
      "../branding/sTool_PDF/app.ico"
    ]
  },
  "mainBinaryName": "solyan-pdf-desktop"
}
