{
  "productName": "sReader PDF",
  "mainBinaryName": "solyan-pdf-reader",
  "identifier": "vn.solyan.pdf.reader",
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' blob: http://127.0.0.1:* ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "sReader PDF",
        "url": "reader.html",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "dragDropEnabled": true,
        "zoomHotkeysEnabled": true,
        "create": false
      }
    ]
  },
  "bundle": {
    "resources": null,
    "shortDescription": "Đọc và ký PDF offline",
    "longDescription": "sReader PDF: đọc, chú thích và ký nhanh PDF offline.",
    "icon": [
      "../branding/sReader_PDF/app.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/reader-default-app-hooks.nsi"
      }
    }
  }
}
