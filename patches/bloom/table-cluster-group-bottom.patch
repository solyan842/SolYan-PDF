-  return text
+  let xml10Text = '';
+  for (const char of text) {
+    const codePoint = char.codePointAt(0);
+    if (codePoint !== undefined && isXml10Char(codePoint)) xml10Text += char;
+  }
+
+  return xml10Text
     .replace(/&/g, '&amp;')
     .replace(/</g, '&lt;')
     .replace(/>/g, '&gt;')
     .replace(/"/g, '&quot;');
 }
