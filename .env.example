# Frontend (baked into Next.js client at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend CORS
SOLYAN_ALLOWED_ORIGINS=http://localhost:3000

# Reverse proxy / network utility security
# Keep false unless requests arrive only through a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=0
# Keep false for public deployments. Enable only for private/self-hosted LAN diagnostics.
ALLOW_PRIVATE_NETWORK_UTILITIES=0

# Internal services
OCR_SERVICE_URL=http://ocr-service:8010
# PP-StructureV3 on CPU can take several minutes for multi-page scanned-table fallbacks.
OCR_XLSX_FALLBACK_TIMEOUT_SECONDS=900
OFFICE_SERVICE_URL=http://office-service:8020
SIGN_SERVICE_URL=http://sign-service:8030
ARCHIVE_SERVICE_URL=http://archive-service:8040

# Cloud Storage V1.8
# Provider credentials are optional operator-owned deployment settings. They are never entered in the browser UI.
CLOUD_STORAGE_CALLBACK_BASE_URL=http://localhost:8000
CLOUD_STORAGE_FRONTEND_BASE_URL=http://localhost:3000
CLOUD_STORAGE_SESSION_TTL_SECONDS=86400
CLOUD_STORAGE_MAX_SESSIONS=512
CLOUD_STORAGE_MAX_FILE_SIZE=104857600
CLOUD_STORAGE_HTTP_TIMEOUT_SECONDS=45
CLOUD_STORAGE_COOKIE_SECURE=0
CLOUD_STORAGE_COOKIE_SAMESITE=lax
# Google Drive uses the least-privilege drive.file scope. Picker values are optional but recommended for selecting existing Drive files.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=
# OneDrive uses Microsoft Graph delegated Files.ReadWrite + offline_access.
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT=common
# WebDAV credentials remain server-side. Point WEBDAV_BASE_URL at the collection root SolYan may access.
# HTTPS is required by default. WEBDAV_ALLOW_INSECURE_HTTP=1 is intended only for trusted local/test servers.
WEBDAV_BASE_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
WEBDAV_VERIFY_TLS=1
WEBDAV_ALLOW_INSECURE_HTTP=0

# PDF Translation V1.6
# Keep PDFMathTranslate/BabelDOC as a separate AGPL service; SolYan core only uses its HTTP API.
TRANSLATION_SERVICE_URL=http://translation-service:11008
TRANSLATION_DEFAULT_SERVICE=argos
TRANSLATION_ALLOWED_SERVICES=argos,ollama,openai,deepl,google,bing
TRANSLATION_LOCAL_SERVICES=argos,ollama
# Public SolYan service IDs can be mapped to deployment-specific upstream provider IDs.
# The default local Argos bridge is consumed by PDFMathTranslate through its OpenAI-compatible provider.
TRANSLATION_UPSTREAM_SERVICE_MAP=argos:openailiked
TRANSLATION_TIMEOUT_SECONDS=900
TRANSLATION_POLL_INTERVAL_SECONDS=1.0
TRANSLATION_MAX_FILE_SIZE=104857600

# External PDFMathTranslate service settings for the local Argos bridge.
# Configure these on the separately deployed translation service, not in the browser.
OPENAILIKED_BASE_URL=http://127.0.0.1:18080/v1
OPENAILIKED_API_KEY=local-only
OPENAILIKED_MODEL=argos-en-vi
OPENAILIKED_STREAM=false

# Experimental PDF -> Office (Bloom, separately deployed)
BLOOM_SERVICE_URL=http://bloom-service:8787
BLOOM_API_KEY=

# Vietnamese Internet utilities
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
SITE_RANK_API_TEMPLATE=https://tranco-list.eu/api/ranks/domain/{domain}