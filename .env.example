# Frontend (baked into Next.js client at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend CORS
SOLYAN_ALLOWED_ORIGINS=http://localhost:3000

# Reverse proxy / network utility security
# Keep false unless requests arrive only through a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=0
# Keep false for public deployments. Enable only for private/self-hosted LAN diagnostics.
ALLOW_PRIVATE_NETWORK_UTILITIES=0

# Internal services
OCR_SERVICE_URL=http://ocr-service:8010
OFFICE_SERVICE_URL=http://office-service:8020
SIGN_SERVICE_URL=http://sign-service:8030
ARCHIVE_SERVICE_URL=http://archive-service:8040

# Experimental PDF -> Office (Bloom, separately deployed)
BLOOM_SERVICE_URL=http://bloom-service:8787
BLOOM_API_KEY=

# Vietnamese Internet utilities
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
SITE_RANK_API_TEMPLATE=https://tranco-list.eu/api/ranks/domain/{domain}
